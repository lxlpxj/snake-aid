# ============================================================
# 蛇伤急救系统 —— Docker Compose 环境变量模板
# 使用方法：复制此文件为 .env，填入真实值
#   cp .env.example .env
# 然后: docker compose up -d --build
# ============================================================

# ====== MySQL ======
MYSQL_ROOT_PASSWORD=root123456

# ====== Redis（可选：设了 requirepass）======
REDIS_PASSWORD=

# ====== 高德地图 Web 服务 API Key（APP 端地理编码用）======
# 免费注册: https://lbs.amap.com/ 控制台 → 创建应用 → Web服务 Key
AMAP_KEY=your_amap_key_here

# ====== JWT Secret（随便写一串长字符串，生产务必改！）======
JWT_SECRET=please-change-to-a-long-random-string
