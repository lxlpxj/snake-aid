# ============================================================
# 蛇伤急救后端 —— 本地配置模板
# 使用方法：复制此文件，重命名为 application.yml，填入真实值
#   cp application.yml.example application.yml
# ============================================================

server:
  port: 8080
  servlet:
    context-path: /api

spring:
  application:
    name: snake-aid-backend

  profiles:
    active: dev

  # ====== 数据库（必填） ======
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/snake?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_mysql_password

  # ====== Redis（短信验证码 / 缓存，可选但建议启用） ======
  data:
    redis:
      host: localhost
      port: 6379
      database: 0
      timeout: 5000ms

  servlet:
    multipart:
      max-file-size: 200MB
      max-request-size: 250MB

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: cn.snake.snakeaidbackend.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: isDeleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# ====== 应用自定义配置 ======
app:
  # 文件上传目录（绝对路径，注意 Windows 用 / 或 \\ 都可以）
  upload-dir: D:/your/path/to/uploads
  # 高德地图 Web 服务 API Key
  # 免费注册: https://lbs.amap.com/ 控制台 → 创建应用 → 绑定 Key → Web 服务
  # 个人开发者免费额度: 每天 5000 次地理编码 + 5000 次逆地理编码
  amap-key: your_amap_key_here

# ====== JWT ======
jwt:
  secret: please-change-to-a-long-random-string-in-production
  expire-hours: 24

# ====== Knife4j 接口文档 ======
springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
knife4j:
  enable: true
  setting:
    language: zh_cn

# ====== 日志 ======
logging:
  level:
    cn.snake.snakeaidbackend: debug
    org.springframework.security: info
